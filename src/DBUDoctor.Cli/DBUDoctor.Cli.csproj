<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dbudoctor</AssemblyName>
    <RootNamespace>DBUDoctor.Cli</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Native AOT for the release binaries (dotnet publish -r <rid>). -->
  <PropertyGroup Condition="'$(PackAsTool)' != 'true'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- The dotnet tool package is framework-dependent: dotnet pack -p:PackAsTool=true. -->
  <PropertyGroup Label="Tool package">
    <ToolCommandName>dbudoctor</ToolCommandName>
    <PackageId>DBUDoctor</PackageId>
    <RollForward>Major</RollForward>
    <Description>Estimates what a Databricks bundle change will cost, per resource, from the pull request diff. Prices classic compute in full on Azure (DBUs and VMs), flags costly patterns, and posts one sticky pull request comment.</Description>
    <PackageTags>databricks;dbu;finops;cost;bundles;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>dbudoctor-package-icon.png</PackageIcon>
    <RepositoryUrl>$(DBUDoctorRepositoryUrl)</RepositoryUrl>
    <PackageProjectUrl>$(DBUDoctorRepositoryUrl)</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DBUDoctor.Core/DBUDoctor.Core.csproj" />
    <ProjectReference Include="../DBUDoctor.Databricks/DBUDoctor.Databricks.csproj" />
    <ProjectReference Include="../DBUDoctor.GitHub/DBUDoctor.GitHub.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup Label="Package assets">
    <None Include="../../README.md" Pack="true" PackagePath="/" Condition="Exists('../../README.md')" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../docs/branding/dbudoctor-package-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DBUDoctor.Tests" />
  </ItemGroup>
</Project>
