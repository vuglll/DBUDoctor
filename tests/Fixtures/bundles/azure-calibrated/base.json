{
  "bundle": {
    "name": "analytics",
    "target": "prod",
    "mode": "production"
  },
  "workspace": {
    "host": "https://adb-1234567890123456.7.azuredatabricks.net"
  },
  "resources": {
    "jobs": {
      "orders_sync": {
        "name": "orders_sync",
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "15.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "num_workers": 4
            }
          }
        ],
        "tasks": [
          {
            "task_key": "sync",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/Workspace/analytics/sync"
            }
          }
        ],
        "schedule": {
          "quartz_cron_expression": "0 0 * * * ?",
          "timezone_id": "UTC"
        }
      },
      "nightly_report": {
        "name": "nightly_report",
        "tasks": [
          {
            "task_key": "report",
            "environment_key": "default",
            "notebook_task": {
              "notebook_path": "/Workspace/analytics/report"
            }
          }
        ],
        "environments": [
          {
            "environment_key": "default",
            "spec": {
              "client": "2"
            }
          }
        ],
        "schedule": {
          "quartz_cron_expression": "0 0 2 * * ?",
          "timezone_id": "UTC"
        }
      }
    },
    "sql_warehouses": {
      "bi": {
        "name": "bi",
        "cluster_size": "Small",
        "enable_serverless_compute": true
      }
    }
  }
}
