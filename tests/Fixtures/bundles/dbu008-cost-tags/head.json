{
  "bundle": {
    "name": "finance",
    "target": "prod",
    "mode": "production"
  },
  "workspace": {
    "host": "https://adb-1234567890123456.7.azuredatabricks.net"
  },
  "resources": {
    "jobs": {
      "ledger": {
        "name": "j",
        "timeout_seconds": 3600,
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "15.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "num_workers": 2
            }
          }
        ],
        "tasks": [
          {
            "task_key": "t",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ],
        "tags": {
          "team": "fin",
          "cost_center": "4711"
        }
      },
      "forecast": {
        "name": "j",
        "timeout_seconds": 3600,
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "15.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "num_workers": 2
            }
          }
        ],
        "tasks": [
          {
            "task_key": "t",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ],
        "tags": {
          "team": "fin"
        }
      },
      "split": {
        "name": "j",
        "timeout_seconds": 3600,
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "15.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "num_workers": 2,
              "custom_tags": {
                "cost_center": "4711"
              }
            }
          }
        ],
        "tasks": [
          {
            "task_key": "t",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ],
        "tags": {
          "team": "fin"
        }
      },
      "serverless_report": {
        "name": "r",
        "timeout_seconds": 600,
        "usage_policy_id": "policy-1",
        "tasks": [
          {
            "task_key": "t",
            "environment_key": "default",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ]
      }
    },
    "sql_warehouses": {
      "bi": {
        "cluster_size": "Small",
        "auto_stop_mins": 10,
        "tags": {
          "custom_tags": [
            {
              "key": "team",
              "value": "fin"
            }
          ]
        }
      }
    }
  }
}
