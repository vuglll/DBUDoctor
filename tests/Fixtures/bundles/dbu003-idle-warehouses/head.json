{
  "bundle": {
    "name": "analytics_sql",
    "target": "prod",
    "mode": "production"
  },
  "workspace": {
    "host": "https://adb-1234567890123456.7.azuredatabricks.net"
  },
  "resources": {
    "sql_warehouses": {
      "bi": {
        "name": "w",
        "cluster_size": "Small",
        "enable_serverless_compute": true,
        "auto_stop_mins": 0
      },
      "reporting": {
        "name": "w",
        "cluster_size": "X-Small",
        "enable_serverless_compute": true
      },
      "adhoc": {
        "name": "w",
        "cluster_size": "Small",
        "enable_serverless_compute": true
      },
      "etl": {
        "name": "w",
        "cluster_size": "Medium",
        "enable_serverless_compute": false,
        "warehouse_type": "PRO",
        "auto_stop_mins": 45
      },
      "quick": {
        "name": "w",
        "cluster_size": "2X-Small",
        "enable_serverless_compute": true,
        "auto_stop_mins": 5
      }
    }
  }
}
