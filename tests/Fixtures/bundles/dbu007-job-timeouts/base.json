{
  "bundle": {
    "name": "etl",
    "target": "prod",
    "mode": "production"
  },
  "workspace": {
    "host": "https://adb-1234567890123456.7.azuredatabricks.net"
  },
  "resources": {
    "jobs": {
      "nightly_etl": {
        "name": "j",
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "15.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "num_workers": 4
            }
          }
        ],
        "tasks": [
          {
            "task_key": "extract",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          },
          {
            "task_key": "transform",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ],
        "schedule": {
          "quartz_cron_expression": "0 0 2 * * ?",
          "timezone_id": "UTC"
        },
        "timeout_seconds": 7200
      },
      "hourly": {
        "name": "j",
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "15.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "num_workers": 4
            }
          }
        ],
        "tasks": [
          {
            "task_key": "extract",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            },
            "timeout_seconds": 600
          },
          {
            "task_key": "transform",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            },
            "timeout_seconds": 600
          }
        ],
        "schedule": {
          "quartz_cron_expression": "0 0 2 * * ?",
          "timezone_id": "UTC"
        }
      }
    }
  }
}
