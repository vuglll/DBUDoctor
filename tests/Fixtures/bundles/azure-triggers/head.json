{
  "bundle": { "name": "triggers", "target": "prod", "mode": "production" },
  "workspace": { "host": "https://adb-1234567890123456.7.azuredatabricks.net" },
  "resources": {
    "jobs": {
      "periodic": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "Standard_DS3_v2", "num_workers": 2 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "trigger": { "periodic": { "interval": 4, "unit": "HOURS" } }
      },
      "paused": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "Standard_DS3_v2", "num_workers": 2 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "schedule": { "quartz_cron_expression": "0 0 6 * * ?", "timezone_id": "UTC", "pause_status": "UNPAUSED" }
      },
      "photon_nightly": {
        "tasks": [ { "task_key": "t", "new_cluster": { "node_type_id": "Standard_DS4_v2", "num_workers": 2, "runtime_engine": "PHOTON" } } ],
        "schedule": { "quartz_cron_expression": "0 0 2 * * ?", "timezone_id": "Europe/Amsterdam" }
      },
      "on_file": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "Standard_DS3_v2", "num_workers": 1 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "trigger": { "file_arrival": { "url": "abfss://landing@acct.dfs.core.windows.net/in/" } }
      },
      "on_table": {
        "tasks": [ { "task_key": "t", "environment_key": "default", "spark_python_task": { "python_file": "x.py" } } ],
        "trigger": { "table_update": { "table_names": ["main.sales.orders"] } }
      },
      "streaming": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "Standard_DS3_v2", "num_workers": 1 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "continuous": { "pause_status": "UNPAUSED" }
      },
      "on_demand": {
        "tasks": [ { "task_key": "t", "new_cluster": { "node_type_id": "Standard_Unknown_v9", "num_workers": 1 } } ]
      }
    },
    "clusters": {
      "shared": { "cluster_name": "shared", "node_type_id": "Standard_DS3_v2", "autoscale": { "min_workers": 1, "max_workers": 8 }, "autotermination_minutes": 60 }
    },
    "sql_warehouses": {
      "reporting": { "cluster_size": "X-Small", "warehouse_type": "PRO", "min_num_clusters": 1, "enable_serverless_compute": true }
    },
    "apps": {
      "dashboard": { "name": "dashboard", "source_code_path": "./app" }
    }
  }
}
