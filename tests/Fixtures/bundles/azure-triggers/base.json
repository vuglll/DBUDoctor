{
  "bundle": { "name": "triggers", "target": "prod", "mode": "production" },
  "workspace": { "host": "https://adb-1234567890123456.7.azuredatabricks.net" },
  "resources": {
    "jobs": {
      "periodic": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "Standard_DS3_v2", "num_workers": 2 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "trigger": { "periodic": { "interval": 1, "unit": "DAYS" } }
      },
      "paused": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "Standard_DS3_v2", "num_workers": 2 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "schedule": { "quartz_cron_expression": "0 0 6 * * ?", "timezone_id": "UTC", "pause_status": "PAUSED" }
      },
      "photon_nightly": {
        "tasks": [ { "task_key": "t", "new_cluster": { "node_type_id": "Standard_DS4_v2", "num_workers": 2 } } ],
        "schedule": { "quartz_cron_expression": "0 0 2 * * ?", "timezone_id": "Europe/Amsterdam" }
      }
    },
    "clusters": {
      "shared": { "cluster_name": "shared", "node_type_id": "Standard_DS3_v2", "autoscale": { "min_workers": 1, "max_workers": 4 }, "autotermination_minutes": 60 }
    },
    "sql_warehouses": {
      "reporting": { "cluster_size": "X-Small", "warehouse_type": "PRO", "min_num_clusters": 1 }
    }
  }
}
