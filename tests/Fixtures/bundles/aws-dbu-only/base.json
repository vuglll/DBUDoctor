{
  "bundle": { "name": "lakehouse", "target": "prod", "mode": "production" },
  "workspace": { "host": "https://dbc-a1b2c3d4-e5f6.cloud.databricks.com" },
  "resources": {
    "jobs": {
      "ingest": {
        "job_clusters": [ { "job_cluster_key": "m", "new_cluster": { "node_type_id": "m5.xlarge", "num_workers": 4 } } ],
        "tasks": [ { "task_key": "t", "job_cluster_key": "m" } ],
        "schedule": { "quartz_cron_expression": "0 0 * * * ?", "timezone_id": "America/New_York" }
      },
      "legacy": {
        "tasks": [ { "task_key": "t", "existing_cluster_id": "0123-456789-abcdefgh" } ],
        "schedule": { "quartz_cron_expression": "0 0 5 * * ?", "timezone_id": "UTC" }
      }
    },
    "pipelines": {
      "cdc": { "continuous": true, "edition": "PRO", "clusters": [ { "label": "default", "node_type_id": "m5.xlarge", "num_workers": 2 } ] }
    },
    "sql_warehouses": {
      "bi": { "cluster_size": "Small", "warehouse_type": "PRO", "min_num_clusters": 1 }
    }
  }
}
