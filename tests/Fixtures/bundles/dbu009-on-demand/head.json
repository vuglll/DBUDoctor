{
  "bundle": {
    "name": "batch",
    "target": "prod",
    "mode": "production"
  },
  "workspace": {
    "host": "https://adb-1234567890123456.7.azuredatabricks.net"
  },
  "resources": {
    "jobs": {
      "nightly": {
        "name": "j",
        "timeout_seconds": 3600,
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "16.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "autoscale": {
                "min_workers": 2,
                "max_workers": 16
              },
              "azure_attributes": {
                "availability": "ON_DEMAND_AZURE",
                "first_on_demand": 1
              }
            }
          }
        ],
        "tasks": [
          {
            "task_key": "t",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ]
      },
      "small": {
        "name": "j",
        "timeout_seconds": 3600,
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "16.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "autoscale": {
                "min_workers": 2,
                "max_workers": 4
              },
              "azure_attributes": {
                "availability": "ON_DEMAND_AZURE",
                "first_on_demand": 1
              }
            }
          }
        ],
        "tasks": [
          {
            "task_key": "t",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ]
      },
      "default_avail": {
        "name": "j",
        "timeout_seconds": 3600,
        "job_clusters": [
          {
            "job_cluster_key": "main",
            "new_cluster": {
              "spark_version": "16.4.x-scala2.12",
              "node_type_id": "Standard_DS3_v2",
              "autoscale": {
                "min_workers": 2,
                "max_workers": 16
              }
            }
          }
        ],
        "tasks": [
          {
            "task_key": "t",
            "job_cluster_key": "main",
            "notebook_task": {
              "notebook_path": "/x"
            }
          }
        ]
      }
    }
  }
}
